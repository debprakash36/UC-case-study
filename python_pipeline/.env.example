# ==============================================================================
# AI Discovery Engine - Environment Configuration Template
# Copy this file to .env and provide your API keys / settings before running collectors.
# IMPORTANT: Never commit your .env file or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Play Store Configuration (Public Access - No API Key Required)
# ------------------------------------------------------------------------------
PLAYSTORE_APP_ID=com.urbanclap.urbanclap
PLAYSTORE_COUNTRY=in
PLAYSTORE_LANGUAGE=en

# ------------------------------------------------------------------------------
# 2. Reddit API Configuration (OAuth Access via PRAW)
# Create an app at: https://www.reddit.com/prefs/apps (Select 'script' type)
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=AIDiscoveryEngine/1.0 by your_reddit_username
REDDIT_SEARCH_QUERIES=urban company,urbanclap,urban company service

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 Configuration
# Enable YouTube Data API v3 and generate an API key in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_SEARCH_QUERIES=Urban Company review,Urban Company service experience

# ------------------------------------------------------------------------------
# 4. Trustpilot Configuration (Public Business Profile Access)
# ------------------------------------------------------------------------------
TRUSTPILOT_BUSINESS_DOMAIN=urbancompany.com
TRUSTPILOT_COUNTRY=in

# ------------------------------------------------------------------------------
# 5. Gemini API Configuration (for Step 3 Batch Analysis)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# General Output Configuration
# ------------------------------------------------------------------------------
DATA_OUTPUT_DIR=data/raw
